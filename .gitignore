node_modules/
.env
.env.*
!.env.example

# Vaults and ledgers are operator state, never committed.
*.vault.json
ledger*.jsonl
*.ledger.jsonl

# Recorded transports may carry sandbox response bodies.
cassette*.json
tape*.json

# Bench output: the results the README cites are committed so a clone can check them.
bench/results/*
!bench/results/latest-mock.json
!bench/results/conformance.json
!bench/results/mutation.json
!bench/results/llm/
!bench/results/llm-addendum-paypal-status/

npm-debug.log*
.DS_Store
