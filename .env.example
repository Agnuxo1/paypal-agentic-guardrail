# Copy to .env and edit. Nothing here is required to run the demo or the bench: with no
# configuration at all the project uses an offline mock of the PayPal sandbox endpoints and a
# mock credential, so `npm run demo` and `npm run bench` work immediately.

# ── What the operator binds ──────────────────────────────────────────────────────────────────
# These are the values the agent can never change. They are read when the policy loads, so they
# stay out of policy/operations.json and out of git.
OPERATOR_MERCHANT_ID=OPERATOR-MERCHANT-0001
OPERATOR_SUPPLIER_EMAIL=supplier@operator.example

# ── Transport ────────────────────────────────────────────────────────────────────────────────
# mock    (default) offline stand-in; nothing reaches PayPal
# sandbox the real PayPal sandbox at api-m.sandbox.paypal.com
GUARDRAIL_TRANSPORT=mock

# ── Credentials ──────────────────────────────────────────────────────────────────────────────
# auto (default) prefers a vault, then the environment, then the mock
# vault | env | mock to choose explicitly
GUARDRAIL_CREDENTIALS=auto

# Option A — encrypted EnigmAgent vault (preferred). Create it with:
#   node src/cli.js vault-init
# It prompts without echo and binds each entry to api-m.sandbox.paypal.com, so the credential
# cannot be resolved for any other destination.
# GUARDRAIL_VAULT=./paypal.vault.json
# GUARDRAIL_VAULT_USER=operator
# GUARDRAIL_VAULT_PASSWORD=

# Option B — plain environment. Simpler, and weaker: the value sits in this process. The CLI
# says so at startup. SANDBOX CREDENTIALS ONLY.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ── Operator console ─────────────────────────────────────────────────────────────────────────
GUARDRAIL_CONSOLE_PORT=7788
# Leave unset to get a fresh token printed at each start. Set it to keep one across restarts.
# GUARDRAIL_CONSOLE_TOKEN=

# ── Audit ledger ─────────────────────────────────────────────────────────────────────────────
# Unset keeps the ledger in memory. Set a path to persist it as hash-chained JSON lines, then
# check it any time with: node src/cli.js ledger-verify <path>
# GUARDRAIL_LEDGER=./ledger.jsonl

# ── Policy ───────────────────────────────────────────────────────────────────────────────────
# GUARDRAIL_POLICY=./policy/operations.json

# Live PayPal is refused unless this is set to exactly yes-i-mean-it. This project is a
# hackathon entry and was only ever run against the sandbox. Leave it unset.
# GUARDRAIL_ALLOW_LIVE=
